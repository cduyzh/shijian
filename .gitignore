# 私人仓库：仅允许项目源码、运行资产及说明文件。
/*
!/.gitignore
!/README.md
!/docs/
!/dist/
!/scripts/
!/tests/

/docs/*
!/docs/PRODUCT.md
!/docs/PRIVACY.md
!/docs/LOCAL-DEVELOPMENT.md
!/docs/NUTRITION-SOURCES.md
!/docs/COOKED-REFERENCES.md
!/docs/visual-assets.md

/dist/*
!/dist/index.html
!/dist/app.js
!/dist/styles.css
!/dist/data.js
!/dist/nutrition.js
!/dist/visuals.js
!/dist/asset-layout.js
!/dist/assets/

/dist/assets/*
!/dist/assets/favicon.svg
!/dist/assets/cooked-hero.jpg
!/dist/assets/ingredients-v4-*.png
!/dist/assets/cooked-v4-*.png
!/dist/assets/ingredients-v4-manifest.json
!/dist/assets/cooked-v4-manifest.json
!/dist/assets/cooked-detail-v5-*.png
!/dist/assets/*-v5.png
!/dist/assets/*-v5.jpg
!/dist/assets/*-v5-manifest.json

# 部署身份、凭据、本机菜单、验收导出及生成历史不提交。
/.site-source/
/.openai/
/.qa/
/.env*
/dist/assets/originals/
**/node_modules/
**/.DS_Store
**/*.log
**/*.sqlite*
**/*.db
**/*-menu-backup*.json
**/*credentials*
