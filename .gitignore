# 私人仓库：仅允许项目源码、运行资产及说明文件。
/*
!/.gitignore
!/README.md
!/docs/
!/dist/
!/scripts/
!/tests/

/docs/*
!/docs/PRODUCT.md
!/docs/PRIVACY.md
!/docs/LOCAL-DEVELOPMENT.md
!/docs/NUTRITION-SOURCES.md
!/docs/COOKED-REFERENCES.md
!/docs/visual-assets.md

/dist/*
!/dist/index.html
!/dist/app.js
!/dist/styles.css
!/dist/data.js
!/dist/nutrition.js
!/dist/visuals.js
!/dist/asset-layout.js
!/dist/assets/

# 仅登记当前在用资产；替换版本时同步收敛清单与校验脚本。
/dist/assets/*
!/dist/assets/favicon.svg
!/dist/assets/cooked-hero.jpg
!/dist/assets/plate-photo-v5.png
!/dist/assets/linen-table-v5.png
!/dist/assets/meal-photo-v5-manifest.json
!/dist/assets/ingredients-hires-v8-*.png
!/dist/assets/ingredients-hires-v8-manifest.json
!/dist/assets/cooked-spread-v9-*.png
!/dist/assets/cooked-spread-v9-manifest.json

# 部署身份、凭据、本机菜单、验收导出及生成历史不提交；归档不得放入 dist。
/.site-source/
/.openai/
/.qa/
/.env*
/dist/assets/originals/
**/node_modules/
**/__pycache__/
**/*.pyc
**/.DS_Store
**/*.log
**/*.sqlite*
**/*.db
**/*-menu-backup*.json
**/*credentials*

# GitHub 仅保存源码与文档；本地构建/发布产物 dist 保留在工作区但不纳入版本库。
/dist/
