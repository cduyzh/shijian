# 公开仓库：提交源码、发布配置与说明；本机运行产物和私有配置保持排除。
/*
!/.gitignore
!/README.md
!/docs/
!/dist/
!/scripts/
!/.github/
!/tests/

/docs/*
!/docs/PRODUCT.md
!/docs/PRIVACY.md
!/docs/LOCAL-DEVELOPMENT.md
!/docs/NUTRITION-SOURCES.md
!/docs/COOKED-REFERENCES.md
!/docs/visual-assets.md
!/docs/RELEASE-DEPLOY.md

/.release-output/

# 部署身份、凭据、本机菜单、验收导出及生成历史不提交；归档不得放入 dist。
/.site-source/
/.openai/
/.qa/
/.env*
/dist/assets/originals/
**/node_modules/
**/__pycache__/
**/*.pyc
**/.DS_Store
**/*.log
**/*.sqlite*
**/*.db
**/*-menu-backup*.json
**/*credentials*

# GitHub 仅保存源码与文档；本地构建/发布产物 dist 保留在工作区但不纳入版本库。
/dist/
